# ==========================================
# Ziwon.AI Frontend (Next.js 15) Environment Config
# ==========================================

# 1. Database Connection (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Backend FastAPI Engine URL (Local or Railway Production)
BACKEND_API_URL="https://ziwonai-production.up.railway.app/api/v1"

# 3. Google Gemini AI Models
AI_PROVIDER="gemini"
AI_FAST_MODEL="gemini-2.5-flash"
AI_GENERAL_MODEL="gemini-3.6-flash"
AI_REASONING_MODEL="gemini-2.5-pro"
GEMINI_API_KEY="your-gemini-api-key-here"

# 4. Official Public OpenAPI Keys
KSTARTUP_API_KEY="your-kstartup-api-key"
BIZINFO_API_KEY="your-bizinfo-api-key"

# 5. SMTP Email OTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"

# 6. JWT Authentication Security (Must match Backend JWT_SECRET)
JWT_SECRET="your-256-bit-secure-hex-jwt-secret-here"
JWT_ALGORITHM="HS256"

# 7. Cron / 내부 배치 인증 (미설정 시 프로덕션에서 크론 라우트가 503 으로 거부됩니다)
#    CRON_SECRET        : Vercel Cron 이 Authorization: Bearer <값> 으로 보냅니다
#    INTERNAL_CRON_SECRET: FastAPI 스케줄러 -> Next.js 관리자 API 호출용 (32자 이상)
CRON_SECRET="generate-with-openssl-rand-hex-32"
INTERNAL_CRON_SECRET="generate-with-openssl-rand-hex-32"

# 8. 관리자 지정
#    평소에는 비워두고 DB User.role = 'ADMIN' 으로 운영하세요.
#    role 이 유실됐을 때만 쓰는 비상용 탈출구입니다. 쉼표로 구분.
ADMIN_EMAILS=""

# 9. Supabase 클라이언트 (소셜 로그인 Google/Kakao 용)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 사용자가 rhwp 에디터에서 편집·저장한 HWP/HWPX 문서는 별도 오브젝트
# 스토리지 없이 SavedDocument.content(Bytes)에 그대로 담는다. 이미 있는
# DATABASE_URL 연결 하나로 끝나서 여기 추가할 키는 없다. 문서량이 늘어나
# DB 용량이 부담되면 그때 오브젝트 스토리지로 옮기는 걸 검토한다.
