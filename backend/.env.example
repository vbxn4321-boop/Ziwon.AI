# ==========================================
# Ziwon.AI FastAPI Backend Environment Config
# ==========================================

# 1. Supabase PostgreSQL Connection URL
# Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# 3. Environment
ENVIRONMENT="production"
PORT=8000

# 4. Redis Cache & Token Blacklist (Railway Redis / Upstash / Local)
# Example: redis://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL="redis://localhost:6379/0"

# 5. JWT Authentication Security (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET="your-256-bit-secure-hex-jwt-secret-here"
JWT_ALGORITHM="HS256"

# 6. Ingestion APIs
BIZINFO_API_KEY="your-bizinfo-api-key"
KSTARTUP_API_KEY="your-kstartup-api-key"

# Vercel AI 분석 배치 호출 (Railway APScheduler → 프론트 API)
FRONTEND_APP_URL="https://your-production-domain.com"
INTERNAL_CRON_SECRET="replace-with-a-random-secret-at-least-32-characters"


# CORS
# allow_origins 는 정확히 일치하는 오리진만 비교합니다(와일드카드 미지원).
# 프로덕션 프론트엔드 주소와 로컬 개발 주소를 쉼표로 나열하세요.
# Vercel 기본 도메인을 쓴다면 그 주소를 그대로 적으면 됩니다.
#   예) https://ziwon-ai.vercel.app
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.com"

# 프리뷰 배포처럼 오리진이 매번 바뀔 때만 사용합니다. 기본은 비활성(빈 값)입니다.
#
# 주의: ^https://[A-Za-z0-9-]*\.vercel\.app$ 같은 패턴은 쓰지 마세요.
# vercel.app 서브도메인은 누구나 무료로 발급받으므로 "Vercel 에 배포한 아무나 허용"이 됩니다.
# 반드시 프로젝트 이름으로 좁히세요:
#   ALLOWED_ORIGIN_REGEX="^https://ziwon-ai[a-z0-9-]*\.vercel\.app$"
ALLOWED_ORIGIN_REGEX=""

# 실행 환경. 미설정 시 Railway/Render 등 플랫폼 환경변수로 자동 추론하지만,
# Redis fail-closed 가드와 OTP 프로덕션 가드가 이 값에 걸려 있으므로 명시를 권장합니다.
ENVIRONMENT="production"
